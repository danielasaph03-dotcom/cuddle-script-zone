# Painel administrativo (/admin) — credenciais do Supabase.
# Copie este arquivo para ".env" e preencha com os valores do seu projeto
# (Supabase Dashboard → Settings → API). Veja ADMIN_SETUP.md para o passo a passo.
#
# Nunca coloque a "service_role key" aqui nem em nenhum outro lugar do projeto —
# só a anon/public key, que é feita para ser exposta no navegador (a segurança
# real vem das políticas de RLS configuradas no banco).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
