# Painel administrativo (/admin) — credenciais do banco MySQL e segredo de sessão.
# Copie este arquivo para ".env" e preencha. Veja ADMIN_SETUP.md para o passo a passo
# (como criar o banco no cPanel, as tabelas e o primeiro admin).
#
# Nunca use o prefixo VITE_ nestas variáveis — elas só devem existir no servidor,
# nunca no bundle enviado pro navegador.

DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=
AUTH_COOKIE_SECRET=
